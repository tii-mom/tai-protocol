# ═══════════════════════════════════════════════════
# TAI Protocol — 环境变量模板
# 复制为 .env 后填入真实值，切勿提交 .env 到 Git
# ═══════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tai_protocol
DB_USER=tai
DB_PASSWORD=change_me_in_production

# ─── Redis ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Telegram Bot ─────────────────────────────────
TG_BOT_TOKEN=123456:ABC-DEF_from_botfather
TG_WEBAPP_URL=https://your-domain.com

# ─── TON Blockchain ───────────────────────────────
TON_API_URL=https://toncenter.com/api/v2
TON_API_KEY=your_toncenter_api_key
TON_MNEMONIC=word1 word2 word3 ... word24
TON_NETWORK=testnet

# ─── TON Contracts (部署后填入) ────────────────────
TAI_JETTON_ADDRESS=
PET_NFT_COLLECTION=
BREEDING_CONTRACT=
STORAGE_CONTRACT=

# ─── 3api.shop Integration (Phase 0: Platform Pool) ───
# ONE platform key for all pets. Pets never touch 3api directly.
THREEAPI_BASE_URL=https://api.3api.shop
THREEAPI_PLATFORM_KEY=sk-xxx-tai-pets-group-key
THREEAPI_INTERNAL_SECRET=shared_secret_for_reconciliation
# Setup: create "tai-pets" group in 3api (rate 0.6), assign platform key to it

# ─── Market Maker ─────────────────────────────────
MM_ENABLED=true
MM_BOT_COUNT=5
MM_BUY_RATIO=0.7
MM_DAILY_CAP_PCT=150
MM_INTERVAL_MS=30000

# ─── Server ───────────────────────────────────────
SERVER_PORT=8080
SERVER_MODE=debug
JWT_SECRET=change_me_random_string
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Misc ─────────────────────────────────────────
LOG_LEVEL=info
ENVIRONMENT=development
