# ═══════════════════════════════════════════════════
# TAI Protocol — 环境变量模板
# 复制为 .env 后填入真实值，切勿提交 .env 到 Git
# ═══════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tai_protocol
DB_USER=tai
DB_PASSWORD=change_me_in_production

# ─── Redis ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Telegram Bot ─────────────────────────────────
TG_BOT_TOKEN=123456:ABC-DEF_from_botfather
TG_WEBAPP_URL=https://your-domain.com

# ─── TON Blockchain ───────────────────────────────
TON_API_URL=https://toncenter.com/api/v2
TON_API_KEY=your_toncenter_api_key
TON_MNEMONIC=word1 word2 word3 ... word24
TON_NETWORK=testnet

# ─── TON Contracts (部署后填入) ────────────────────
TAI_JETTON_ADDRESS=
PET_NFT_COLLECTION=
BREEDING_CONTRACT=
STORAGE_CONTRACT=

# ─── 3api.shop Integration ────────────────────────
API_3API_BASE_URL=https://3api.shop
API_3API_KEY=your_3api_admin_key
API_3API_PET_GROUP=tai-pets

# ─── Market Maker ─────────────────────────────────
MM_ENABLED=true
MM_BOT_COUNT=5
MM_BUY_RATIO=0.7
MM_DAILY_CAP_PCT=150
MM_INTERVAL_MS=30000

# ─── Server ───────────────────────────────────────
SERVER_PORT=8080
SERVER_MODE=debug
JWT_SECRET=change_me_random_string
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Misc ─────────────────────────────────────────
LOG_LEVEL=info
ENVIRONMENT=development
